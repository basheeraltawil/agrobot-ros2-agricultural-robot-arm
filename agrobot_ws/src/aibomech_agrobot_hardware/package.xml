<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aibomech_agrobot_hardware</name>
  <version>2.0.0</version>
  <description>ros2_control hardware interface for the real AIBOMECH AgroBot: serial link to the motor-controller board, plus its firmware and a board emulator.</description>
  <maintainer email="basheer.altawil@gmail.com">Basheer Al-Tawil</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>hardware_interface</depend>
  <depend>pluginlib</depend>
  <depend>rclcpp</depend>
  <depend>rclcpp_lifecycle</depend>

  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
