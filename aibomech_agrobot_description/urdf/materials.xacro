<?xml version="1.0"?>
<!-- Colours. Visuals use <xacro:mat name="..."/> so every material carries its
     colour inline: Gazebo drops named-only materials on links merged by
     fixed-joint reduction and renders them black. -->
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:property name="agro_colors" value="${dict(
      agro_orange='0.93 0.45 0.07 1',
      graphite='0.20 0.21 0.23 1',
      aluminium='0.76 0.77 0.79 1',
      cabinet_grey='0.60 0.62 0.64 1',
      black='0.06 0.06 0.06 1',
      pipe_white='0.92 0.92 0.90 1',
      crate_green='0.10 0.45 0.20 1',
      safety_yellow='1.00 0.80 0.00 1',
      estop_red='0.85 0.05 0.05 1',
      signal_green='0.10 0.85 0.20 1')}"/>

  <xacro:macro name="mat" params="name">
    <material name="${name}"><color rgba="${agro_colors[name]}"/></material>
  </xacro:macro>
</robot>
