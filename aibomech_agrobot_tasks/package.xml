<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aibomech_agrobot_tasks</name>
  <version>2.0.0</version>
  <description>Agricultural task nodes for the AIBOMECH AgroBot: strawberry harvesting, seedling transplanting, precision weeding and plant inspection, with RGB-D crop detection and IK-based motion.</description>
  <maintainer email="basheer.altawil@gmail.com">Basheer Al-Tawil</maintainer>
  <license>BSD-3-Clause</license>

  <exec_depend>aibomech_agrobot_bringup</exec_depend>
  <exec_depend>aibomech_agrobot_gazebo</exec_depend>
  <exec_depend>builtin_interfaces</exec_depend>
  <exec_depend>control_msgs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>python3-numpy</exec_depend>
  <exec_depend>python3-opencv</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>tf2_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>trajectory_msgs</exec_depend>
  <exec_depend>visualization_msgs</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
