<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>aibomech_agrobot_gazebo</name>
  <version>2.0.0</version>
  <description>Gazebo Sim (Fortress) agricultural scenario worlds for the AIBOMECH AgroBot: strawberry greenhouse, nursery transplanting bench and weeding bed.</description>
  <maintainer email="basheer.altawil@gmail.com">Basheer Al-Tawil</maintainer>
  <license>BSD-3-Clause</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>aibomech_agrobot_bringup</exec_depend>
  <exec_depend>aibomech_agrobot_description</exec_depend>
  <exec_depend>gz_ros2_control</exec_depend>
  <exec_depend>python3-yaml</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>xacro</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
